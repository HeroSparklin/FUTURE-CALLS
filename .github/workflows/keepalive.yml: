name: keepalive
on:
  schedule:
    - cron: '0 0 * * *'
jobs:
  keepalive:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: |
          git config user.name "bot"
          git config user.email "bot@bot.com"
          git commit --allow-empty -m "keep alive"
          git push
